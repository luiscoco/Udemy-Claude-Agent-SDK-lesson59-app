{
  "name": "claude-agent-sdk-lesson59-platform-migrations",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Four real Claude execution paths, platform trade-offs and small migration regressions",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "agent": "npm run sample:env",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test src/agent.test.ts src/startup.test.ts",
    "sample": "tsx src/sample.ts",
    "sample:env": "tsx --env-file-if-exists=.env src/sample.ts",
    "pipeline": "tsx --env-file-if-exists=.env src/sample.ts",
    "eval": "npm run pipeline -- compare",
    "cleanup": "tsx --env-file-if-exists=.env src/cleanup.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "zod": "4.6.7",
    "@anthropic-ai/sdk": "0.135.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
